{
  "name": "@legichain/sdk",
  "version": "2.0.0",
  "description": "Official Legichain React Native SDK with guided KYC, NFC, active liveness and TR/EN screens.",
  "homepage": "https://legichain.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/legichain/legichain-react-native.git"
  },
  "license": "MIT",
  "author": "Legichain",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "dist",
    "src",
    "*.podspec",
    "react-native.config.js",
    "native-source.json",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "KYC-V2.md",
    "kyc-contract.json",
    "android/src",
    "android/build.gradle",
    "android/settings.gradle",
    "android/consumer-rules.pro",
    "ios/Core",
    "ios/LegichainKycModule.swift",
    "ios/LegichainKycModule.m",
    "android/gradle.properties",
    "VALIDATION.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react-native --external react",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/react": "^18.2.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "tsup": "^8.5.0"
  },
  "keywords": [
    "legichain",
    "kyc",
    "aml",
    "sanctions",
    "screening",
    "address-verification",
    "nfc",
    "emrtd",
    "react-native"
  ]
}
