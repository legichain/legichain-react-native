    "LivenessVideoFrame": {
      "additionalProperties": false,
      "description": "One frame of a multi-frame liveness video.\n\nThe mobile SDK captures ~5-15 frames during the active-challenge\nsequence, base64-encodes each, and submits them alongside the\nrepresentative frame for multi-frame temporal analysis (M19+).",
      "properties": {
        "image_b64": {
          "maxLength": 2000000,
          "minLength": 128,
          "title": "Image B64",
          "type": "string"
        },
        "timestamp_ms": {
          "minimum": 0,
          "title": "Timestamp Ms",
          "type": "integer"
        }
      },
      "required": [
        "image_b64",
        "timestamp_ms"
      ],
      "title": "LivenessVideoFrame",
      "type": "object"
    },
    "LivenessSubmitRequest": {
      "$defs": {
        "LivenessActionRecord": {
          "additionalProperties": false,
          "description": "One completed action in the active challenge sequence.",
          "properties": {
            "action": {
              "enum": [
                "blink",
                "head_left",
                "head_right",
                "smile",
                "look_up"
              ],
              "title": "Action",
              "type": "string"
            },
            "started_at_ms": {
              "minimum": 0,
              "title": "Started At Ms",
              "type": "integer"
            },
            "ended_at_ms": {
              "minimum": 0,
              "title": "Ended At Ms",
              "type": "integer"
            }
          },
          "required": [
            "action",
            "started_at_ms",
            "ended_at_ms"
          ],
          "title": "LivenessActionRecord",
          "type": "object"
        },
        "LivenessVideoFrame": {
          "additionalProperties": false,
          "description": "One frame of a multi-frame liveness video.\n\nThe mobile SDK captures ~5-15 frames during the active-challenge\nsequence, base64-encodes each, and submits them alongside the\nrepresentative frame for multi-frame temporal analysis (M19+).",
          "properties": {
            "image_b64": {
              "maxLength": 2000000,
              "minLength": 128,
              "title": "Image B64",
              "type": "string"
            },
            "timestamp_ms": {
              "minimum": 0,
              "title": "Timestamp Ms",
              "type": "integer"
            }
          },
          "required": [
            "image_b64",
            "timestamp_ms"
          ],
          "title": "LivenessVideoFrame",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "Mobile submits a representative frame + (optionally) the active\nchallenge completion log + (optionally) multi-frame video for\ntemporal liveness verification.\n\n`mode='passive'` runs single-frame PAD only (moire + saturation +\nglare). `mode='active'` additionally validates the action sequence\nagainst the previously-issued challenge AND, when ``frames`` is\nsupplied, runs MediaPipe FaceMesh-based temporal analysis to\nconfirm the actions actually occurred.",
      "properties": {
        "mode": {
          "enum": [
            "passive",
            "active"
          ],
          "title": "Mode",
          "type": "string"
        },
        "frame_b64": {
          "maxLength": 8000000,
          "minLength": 128,
          "title": "Frame B64",
          "type": "string"
        },
        "frame_mime_type": {
          "default": "image/jpeg",
          "enum": [
            "image/jpeg",
