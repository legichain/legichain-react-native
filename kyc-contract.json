    "NFCSubmitRequest": {
      "additionalProperties": false,
      "description": "Mobile-side NFC chip read submission.\n\nAll DG / SOD payloads are base64-encoded raw bytes (ICAO 9303\nlayout: outer 0x6N tag + length + value). The server validates\nthem with `kyc/nfc/verifier.verify_nfc()` against the trusted CSCA\nstore (kyc_csca_certificates).\n\nFaz G-7.6: ``access_error`` distinguishes a chip *read* failure\n(user couldn't get the phone close enough, antenna noise, chip\ndidn't respond) from a chip *content* failure (read succeeded but\nSOD/DG hashes don't verify → tampered). Access errors keep the\napplication at AWAITING_NFC so the user can try the read again;\ncontent failures push to REJECTED via HARD_NFC_HASH_MISMATCH.",
      "properties": {
        "protocol": {
          "enum": [
            "BAC",
            "PACE"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "key_derivation": {
          "anyOf": [
            {
              "enum": [
                "MRZ",
                "CAN"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Derivation"
        },
        "access_error": {
          "default": false,
          "title": "Access Error",
          "type": "boolean"
        },
        "access_error_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Error Code"
        },
        "sod_b64": {
          "anyOf": [
            {
              "maxLength": 1500000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sod B64"
        },
        "dg1_b64": {
          "anyOf": [
            {
              "maxLength": 200000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dg1 B64"
        },
        "dg2_b64": {
          "anyOf": [
            {
              "maxLength": 400000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dg2 B64"
        },
        "dg7_b64": {
          "anyOf": [
