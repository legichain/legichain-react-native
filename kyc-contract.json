              "maxLength": 200000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dg7 B64"
        },
        "dg11_b64": {
          "anyOf": [
            {
              "maxLength": 200000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dg11 B64"
        },
        "dg12_b64": {
          "anyOf": [
            {
              "maxLength": 200000,
