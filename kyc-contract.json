    "KYCSubmitRequest": {
      "additionalProperties": false,
      "description": "Final submission — server assembles artifacts + runs decision pipeline.\n\nThe mobile/web client signals that all evidence has been provided\n(documents, optional NFC, selfie, liveness) and the server should now:\n  - evaluate hard-fail rules\n  - compute weighted risk score\n  - apply tenant policy thresholds\n  - persist `kyc_risk_scores` + `kyc_decisions` + optional manual review\n  - update the persona's identity attestation\n  - emit `kyc.completed` (or `kyc.manual_review.assigned`) webhook",
      "properties": {
        "notes": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "KYCSubmitRequest",
      "type": "object"
    },
    "KYCSubmitResponse": {
      "additionalProperties": false,
      "description": "The verdict, or an honest statement that there isn't one yet.\n\nBiometric evidence is produced by a worker, so at the moment submit\nis called the face match may still be running. The old contract had\nno way to say that: every field was required, so the only way to\nanswer was to decide without the evidence — which scored the\nmissing-evidence penalty and rejected the applicant.\n\nWhen `pending` is true the decision has not run. `outcome`,\n`decision_id` and `risk_score` are null because they do not exist\nyet, not because they failed. Poll `GET /applications/{id}/status`\nor wait for the `kyc.completed` webhook; both already carry the\noutcome once it lands. The response also arrives as HTTP 202 rather\nthan 200, so a client can branch on the status line alone.",
      "properties": {
        "application_id": {
          "title": "Application Id",
          "type": "string"
        },
        "persona_id": {
          "title": "Persona Id",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "approved",
                "rejected",
                "manual_review"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "outcome_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome Reason"
        },
        "decision_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Id"
        },
        "risk_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Score"
        },
        "risk_components": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Risk Components",
          "type": "object"
        },
        "hard_fail_codes": {
          "items": {
            "type": "string"
          },
          "title": "Hard Fail Codes",
          "type": "array"
        },
        "manual_review_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Review Id"
        },
        "manual_review_priority": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Review Priority"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "pending": {
          "default": false,
          "title": "Pending",
          "type": "boolean"
        },
        "pending_on": {
          "items": {
            "type": "string"
          },
          "title": "Pending On",
          "type": "array"
        },
        "poll_after_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Poll After Ms"
        }
      },
      "required": [
        "application_id",
        "persona_id",
        "state"
      ],
      "title": "KYCSubmitResponse",
      "type": "object"
    },
    "DocumentSubmitRequest": {
      "additionalProperties": false,
      "description": "Mobile/web client upload for one document side.\n\nAll document images are base64-encoded raw bytes (JPEG/PNG/HEIC).\nThe server decodes, runs OpenCV IQA pre-check (Laplacian + glare),\npersists the blob to encrypted object storage (managed/BYOC), creates\n`kyc_documents` + `kyc_document_images` rows, and enqueues an\nasynchronous `process_kyc_ocr` task for Tesseract + MRZ extraction.\n\n`side` semantics:\n- tr_id_card / driver_license: front + back (two calls).\n- passport: single (one call; MRZ is on the data page).",
      "properties": {
        "document_type": {
          "enum": [
            "tr_id_card",
            "passport",
            "driver_license",
            "eu_national_id",
            "uk_passport"
          ],
          "title": "Document Type",
          "type": "string"
        },
        "side": {
          "enum": [
            "front",
            "back",
            "single"
          ],
          "title": "Side",
          "type": "string"
        },
        "mime_type": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/heic"
          ],
          "title": "Mime Type",
          "type": "string"
        },
        "image_b64": {
          "maxLength": 12000000,
          "minLength": 128,
          "title": "Image B64",
          "type": "string"
        },
        "captured_at_client": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At Client"
        },
        "device_attestation": {
          "additionalProperties": true,
          "title": "Device Attestation",
          "type": "object"
        }
      },
      "required": [
        "document_type",
        "side",
        "mime_type",
        "image_b64"
      ],
      "title": "DocumentSubmitRequest",
      "type": "object"
    },
    "SelfieSubmitRequest": {
      "additionalProperties": false,
      "description": "Mobile/web client selfie upload.\n\nSubmits one selfie (image or short video frame) as base64. Server:\n  1. Runs OpenCV Haar face-quality assessment inline.\n  2. Persists the blob + creates `kyc_selfies` row.\n  3. Enqueues `process_kyc_face_match` ARQ task that matches against\n     the front-side document image.",
      "properties": {
        "mime_type": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/heic"
          ],
          "title": "Mime Type",
          "type": "string"
        },
        "image_b64": {
          "maxLength": 8000000,
          "minLength": 128,
          "title": "Image B64",
          "type": "string"
        },
        "is_video": {
          "default": false,
          "title": "Is Video",
          "type": "boolean"
        },
        "captured_at_client": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At Client"
        },
        "device_attestation": {
          "additionalProperties": true,
          "title": "Device Attestation",
          "type": "object"
        }
      },
      "required": [
        "mime_type",
        "image_b64"
      ],
      "title": "SelfieSubmitRequest",
      "type": "object"
    },
    "LivenessChallengeRequest": {
      "additionalProperties": false,
      "description": "Mobile asks the server for a randomised active-challenge sequence.\n\nMobile then prompts the user through the requested actions (blink,\nhead_left, smile, etc.) recording frame metadata, and submits the\ncompleted action log back via `POST /liveness`.",
      "properties": {
        "length": {
          "default": 3,
          "maximum": 5,
          "minimum": 2,
          "title": "Length",
          "type": "integer"
        },
        "ttl_seconds": {
          "default": 60,
          "maximum": 300,
          "minimum": 30,
          "title": "Ttl Seconds",
          "type": "integer"
        }
      },
      "title": "LivenessChallengeRequest",
      "type": "object"
    },
    "LivenessChallengeResponse": {
