          "type": "string"
        },
        "sequence": {
          "items": {
            "type": "string"
          },
          "title": "Sequence",
          "type": "array"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "application_id",
        "challenge_token",
        "sequence",
        "issued_at",
        "valid_until"
      ],
      "title": "LivenessChallengeResponse",
      "type": "object"
    },
